# ==============================================================================
# SECRETS & ENVIRONMENT VARIABLES (CRITICAL - NEVER COMMIT TO GIT)
# ==============================================================================
.env
.env.*
*.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local
backend/.env
frontend/.env
*.pem
*.key
*.cert
*.crt
service-account*.json
credentials.json
secrets/

# Allow example env files to be tracked
!.env.example
!backend/.env.example
!frontend/.env.example

# ==============================================================================
# PYTHON / BACKEND
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
backend/venv/
backend/.venv/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

# Local databases & sqlite
*.db
*.sqlite
*.sqlite3
backend/*.db
backend/*.sqlite
backend/*.sqlite3

# Uploaded media (user avatars, post uploads)
backend/uploads/*
!backend/uploads/.gitkeep
uploads/

# ==============================================================================
# NODE / FRONTEND
# ==============================================================================
node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/
.pnp
.pnp.js
.npm/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# ==============================================================================
# OS & SYSTEM FILES
# ==============================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ==============================================================================
# IDE & EDITORS
# ==============================================================================
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~
